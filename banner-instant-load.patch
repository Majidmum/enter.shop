 import type { Product, Brand, Banner, Promotion } from '@/types';
 
+// Баннеры всё равно управляются админом через базу (Supabase), но сам запрос
+// занимает время — без кэша посетитель первую секунду видел бы пустой блок
+// вместо баннера. Поэтому последний успешно загруженный набор баннеров
+// сохраняется в localStorage и подставляется СРАЗУ при открытии страницы —
+// ещё до ответа от сервера. Как только приходят свежие данные, баннер тихо
+// обновляется и кэш перезаписывается.
+const BANNERS_CACHE_KEY = 'enter-tj-banners-cache-v1';
+
+function readCachedBanners(): Banner[] {
+  try {
+    const raw = localStorage.getItem(BANNERS_CACHE_KEY);
+    if (!raw) return [];
+    const parsed = JSON.parse(raw);
+    return Array.isArray(parsed) ? parsed : [];
+  } catch {
+    return [];
+  }
+}
+
+function writeCachedBanners(banners: Banner[]) {
+  try {
+    localStorage.setItem(BANNERS_CACHE_KEY, JSON.stringify(banners));
+  } catch {
+    // localStorage может быть недоступен (приватный режим и т.п.) — не критично,
+    // баннер в этом случае просто подождёт обычный запрос, как раньше.
+  }
+}
