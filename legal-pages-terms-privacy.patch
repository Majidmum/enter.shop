+import PageMeta from '@/components/common/PageMeta';
+import Breadcrumb from '@/components/shared/Breadcrumb';
+
+export default function TermsPage() {
+  return (
+    <div className="container mx-auto px-4 py-6 pb-20 md:pb-6 max-w-3xl">
+      <PageMeta
+        title="Публичная оферта — ENTER.TJ"
+        description="Условия использования сайта и оформления заказов в интернет-магазине ENTER.TJ."
+        canonicalPath="/terms"
+      />
+      <Breadcrumb items={[{ label: 'Публичная оферта' }]} />
+      <h1 className="text-2xl font-bold mt-4 mb-2">Публичная оферта</h1>
+      <p className="text-sm text-muted-foreground mb-6">Последнее обновление: сентябрь 2026</p>
+
+      <div className="flex flex-col gap-6 text-sm leading-relaxed text-foreground">
+        <section>
+          <h2 className="font-semibold text-base mb-2">1. Общие положения</h2>
+          <p>
+            Настоящий документ является публичной офертой интернет-магазина ENTER.TJ (далее — «Продавец»)
+            и определяет условия продажи товаров через сайт enter.tj любому дееспособному физическому или
+            юридическому лицу (далее — «Покупатель»). Оформление заказа на сайте означает полное и
+            безоговорочное согласие Покупателя с условиями настоящей оферты.
+          </p>
+        </section>
+
+        <section>
+          <h2 className="font-semibold text-base mb-2">2. Товары и цены</h2>
+          <p>
+            Информация о товарах (наименование, характеристики, цена, фотографии) размещается на сайте
+            Продавцом. Продавец вправе изменять ассортимент, цены и условия акций без предварительного
+            уведомления. Цена товара фиксируется на момент подтверждения заказа.
+          </p>
+        </section>
+
+        <section>
+          <h2 className="font-semibold text-base mb-2">3. Оформление заказа</h2>
+          <p>
+            Заказ оформляется через сайт путём добавления товара в корзину и заполнения контактных данных.
+            После оформления заказа с Покупателем может связаться сотрудник Продавца для подтверждения
+            деталей заказа, адреса и способа доставки.
+          </p>
+        </section>
+
+        <section>
+          <h2 className="font-semibold text-base mb-2">4. Оплата</h2>
+          <p>
+            Оплата производится способом, выбранным Покупателем при оформлении заказа, из числа доступных
+            на сайте на момент заказа (наличными при получении, банковским переводом или онлайн-способами,
+            если они активны).
+          </p>
+        </section>
+
+        <section>
+          <h2 className="font-semibold text-base mb-2">5. Доставка</h2>
+          <p>
+            Условия и сроки доставки указаны на странице «Доставка». Продавец вправе уточнить у Покупателя
+            детали доставки перед отправкой заказа.
+          </p>
+        </section>
+
+        <section>
+          <h2 className="font-semibold text-base mb-2">6. Возврат и обмен</h2>
+          <p>
+            Покупатель вправе вернуть товар надлежащего качества в течение 14 дней с момента получения, при
+            условии сохранения товарного вида, упаковки и потребительских свойств. Возврат товара
+            ненадлежащего качества осуществляется в соответствии с гарантийными условиями производителя.
+          </p>
+        </section>
+
+        <section>
+          <h2 className="font-semibold text-base mb-2">7. Ответственность сторон</h2>
+          <p>
+            Продавец не несёт ответственности за ущерб, причинённый Покупателю вследствие неправильного
+            использования товаров, приобретённых на сайте. Продавец не несёт ответственности за временную
+            недоступность сайта по техническим причинам.
+          </p>
+        </section>
+
+        <section>
+          <h2 className="font-semibold text-base mb-2">8. Контакты</h2>
+          <p>
+            По всем вопросам, связанным с настоящей офертой, обращайтесь по контактам, указанным на странице
+            «Контакты».
+          </p>
+        </section>
+      </div>
+    </div>
+  );
+}
