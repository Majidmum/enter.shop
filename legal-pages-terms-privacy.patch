+import PageMeta from '@/components/common/PageMeta';
+import Breadcrumb from '@/components/shared/Breadcrumb';
+
+export default function PrivacyPage() {
+  return (
+    <div className="container mx-auto px-4 py-6 pb-20 md:pb-6 max-w-3xl">
+      <PageMeta
+        title="Политика конфиденциальности — ENTER.TJ"
+        description="Как ENTER.TJ собирает, использует и защищает персональные данные покупателей."
+        canonicalPath="/privacy"
+      />
+      <Breadcrumb items={[{ label: 'Политика конфиденциальности' }]} />
+      <h1 className="text-2xl font-bold mt-4 mb-2">Политика конфиденциальности</h1>
+      <p className="text-sm text-muted-foreground mb-6">Последнее обновление: сентябрь 2026</p>
+
+      <div className="flex flex-col gap-6 text-sm leading-relaxed text-foreground">
+        <section>
+          <h2 className="font-semibold text-base mb-2">1. Какие данные мы собираем</h2>
+          <p>
+            При регистрации и оформлении заказа на сайте ENTER.TJ мы можем собирать: имя, номер телефона,
+            адрес электронной почты, адрес доставки. Эти данные предоставляются Покупателем добровольно при
+            заполнении форм на сайте.
+          </p>
+        </section>
+
+        <section>
+          <h2 className="font-semibold text-base mb-2">2. Как мы используем данные</h2>
+          <p>
+            Собранные данные используются исключительно для обработки и доставки заказов, связи с
+            Покупателем по вопросам заказа, а также — при согласии Покупателя — для информирования об акциях
+            и новых товарах. Мы не продаём и не передаём персональные данные третьим лицам, за исключением
+            служб доставки в объёме, необходимом для доставки заказа.
+          </p>
+        </section>
+
+        <section>
+          <h2 className="font-semibold text-base mb-2">3. Хранение и защита данных</h2>
+          <p>
+            Данные хранятся на защищённых серверах с ограниченным доступом. Мы принимаем разумные технические
+            и организационные меры для защиты персональных данных от несанкционированного доступа, изменения
+            или удаления.
+          </p>
+        </section>
+
+        <section>
+          <h2 className="font-semibold text-base mb-2">4. Файлы cookie</h2>
+          <p>
+            Сайт может использовать файлы cookie для сохранения предпочтений (например, выбранного языка или
+            товаров в корзине) и улучшения работы сайта. Отключение cookie в браузере может ограничить
+            некоторые функции сайта.
+          </p>
+        </section>
+
+        <section>
+          <h2 className="font-semibold text-base mb-2">5. Права пользователя</h2>
+          <p>
+            Покупатель вправе запросить у Продавца информацию о хранимых персональных данных, а также
+            потребовать их исправления или удаления, обратившись по контактам, указанным на странице
+            «Контакты».
+          </p>
+        </section>
+
+        <section>
+          <h2 className="font-semibold text-base mb-2">6. Изменения политики</h2>
+          <p>
+            Продавец вправе вносить изменения в настоящую политику конфиденциальности. Актуальная версия
+            всегда доступна на этой странице.
+          </p>
+        </section>
+      </div>
+    </div>
+  );
+}
